# Copy to .env and adjust. Everything here has a working local default except
# the external service keys, which are optional: without them the app runs with
# the fake LLM provider, the console email transport, and Turnstile in test mode.

# ---------------------------------------------------------------- runtime
NODE_ENV=development
LOG_LEVEL=debug

# ---------------------------------------------------------------- services
API_PORT=4000
WEB_PORT=3000
# Browser-facing origins. In production these are sibling subdomains so one
# parent-domain session cookie covers both.
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
# Comma-separated exact origins allowed to send credentialed requests.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------- datastores
DATABASE_URL=postgresql://shelf:shelf@localhost:5432/shelf
REDIS_URL=redis://localhost:6379
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---------------------------------------------------------------- sessions
# 32+ random bytes. Generate with: openssl rand -base64 48
SESSION_SECRET=dev-only-session-secret-change-me-0000000000
# Secret for signing the guest id cookie and HMACing IP addresses.
GUEST_SECRET=dev-only-guest-secret-change-me-00000000000
# Leave empty in development so the cookie stays host-only. In production set
# the parent domain, e.g. .shelf.example, so web and api share it.
COOKIE_DOMAIN=
SESSION_TTL_DAYS=30

# ---------------------------------------------------------------- credits
GUEST_DAILY_CREATE_CREDITS=3
GUEST_DAILY_RUN_CREDITS=5
USER_DAILY_RUN_CREDITS=50
# Ceiling across all actors, so one abuser cannot drain the free Gemini quota.
LLM_GLOBAL_DAILY_CAP=2000

# ---------------------------------------------------------------- model access
# Unset: the API uses FakeProvider and every model-backed tool still works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_MS=20000
LLM_MAX_OUTPUT_TOKENS=2048

# ---------------------------------------------------------------- oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/oauth/google/callback

# ---------------------------------------------------------------- email
# Unset: verification and reset links are printed to the API log.
RESEND_API_KEY=
EMAIL_FROM="Shelf <noreply@shelf.example>"

# ---------------------------------------------------------------- bot check
# Cloudflare's documented always-pass test pair. Replace in production.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ---------------------------------------------------------------- admin + cron
# Comma-separated. These addresses get the admin role on signup or on seed.
ADMIN_EMAILS=
# Bearer token the scheduled trending recompute presents to /api/v1/cron/trending.
CRON_SECRET=dev-only-cron-secret-change-me
