{
  "name": "@shelf/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "clean": "rimraf dist .turbo",
    "migrate": "node dist/migrate.js"
  },
  "dependencies": {
    "@google/genai": "^2.25.0",
    "@node-rs/argon2": "^2.2.1",
    "@shelf/db": "workspace:*",
    "@shelf/shared": "workspace:*",
    "arctic": "^3.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "diff": "catalog:",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "node-cron": "^4.6.0",
    "obscenity": "^0.4.6",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "rate-limiter-flexible": "^11.2.1",
    "resend": "^6.31.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "catalog:",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@shelf/config": "workspace:*",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "catalog:",
    "pino-pretty": "^13.1.3",
    "rimraf": "catalog:",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
