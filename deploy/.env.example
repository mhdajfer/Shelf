# Copy to deploy/.env on the server. That file is never committed.
# ./deploy.sh adds SHELF_TAG, the commit that is running; leave that line to it.

# The public hostname, without a scheme. Its DNS must point at this server.
SITE_HOST=shelf.example

# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
SESSION_SECRET=
GUEST_SECRET=
CRON_SECRET=

# Optional. Leave a line commented out, not empty, to keep the feature off.

# Test runs against a real model. Without it runs are simulated.
# GEMINI_API_KEY=

# Real email. Without it verification and reset links are printed to the API log.
# RESEND_API_KEY=
# EMAIL_FROM="Shelf <noreply@shelf.example>"

# Google sign-in. The redirect URI is https://<SITE_HOST>/api/v1/auth/oauth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

# Bot check on sign-up and guest posts. Without them the check is skipped.
# The site key is compiled into the web image, so it is also set as the
# TURNSTILE_SITE_KEY repository variable on GitHub, which CI builds with.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Comma-separated; these accounts become admins once their email is verified.
# ADMIN_EMAILS=
