# Caddy obtains and renews the certificate for this hostname by itself; ports 80
# and 443 must be open to the internet for that.
{$SITE_HOST} {
	# The API, including its streamed test runs, which Caddy flushes as they arrive.
	handle /api/* {
		reverse_proxy api:4000
	}

	handle {
		encode zstd gzip
		reverse_proxy web:3000
	}
}
