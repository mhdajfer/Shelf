# Caddy obtains and renews the certificate for this hostname by itself; ports 80
# and 443 must be open to the internet for that.
{$SITE_HOST} {
	# The API, including its streamed test runs, which Caddy flushes as they arrive.
	handle /api/* {
		reverse_proxy api:4000
	}

	# The MCP endpoint for Claude Code and other clients. It answers with an event
	# stream when a call reports progress, which Caddy also passes through as it
	# arrives.
	handle /mcp {
		reverse_proxy api:4000
	}

	# OAuth discovery for MCP clients: the protected resource and authorization
	# server metadata. The OAuth endpoints themselves are under /api/*.
	handle /.well-known/oauth-* {
		reverse_proxy api:4000
	}

	handle {
		encode zstd gzip
		reverse_proxy web:3000
	}
}
